# ---- La Maja 13 / La Casa : variables de server/.env (PRODUCTION) ----
# Sur le serveur, vps-setup.sh pose les questions et écrit ce fichier : pas besoin de le copier à la main.
# En dev, rien à configurer : compose.yaml à la racine fournit tout (docker compose up).

# URL publique du site (sans slash final) — sert aussi pour le callback Discord
BASE_URL=https://exemple.fr
# Port de la machine sur lequel le conteneur écoute (127.0.0.1) ; nginx y renvoie les requêtes
HOST_PORT=3000
# Secret de session : openssl rand -hex 32
SESSION_SECRET=
# Mot de passe de la base (conteneur maja13-db) ; l'app en déduit DATABASE_URL
POSTGRES_PASSWORD=

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID du serveur Discord : seuls ses membres peuvent entrer
DISCORD_GUILD_ID=
# IDs Discord des propriétaires du site, séparés par des virgules : pouvoirs complets quel que soit
# leur grade (indispensable pour créer les premiers grades dans Gestion → Hiérarchie)
ADMIN_DISCORD_IDS=

# Stockage des photos de la galerie : les deux, ou aucun (= disque du serveur, volume maja13-uploads)
STORAGE_URL=
STORAGE_TOKEN=

# Bot Discord (géré à part) : valeurs fournies par son équipe ; vides = pages liées au bot désactivées
BOT_DATABASE_URL=
BOT_API_URL=
BOT_API_TOKEN=

# Dev uniquement (refusé si BASE_URL n'est pas http://localhost) : connexion sans Discord
# DEV_LOGIN=1
