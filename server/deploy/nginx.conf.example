# Site nginx. Copier dans /etc/nginx/sites-available/<domaine>.conf, remplacer __DOMAIN__ (domaine), __PORT__ (HOST_PORT
# du .env) et __SITE_ID__ (SITE_ID du .env, tirets remplacés par des _), activer (lien dans sites-enabled), nginx -t,
# recharger. Ordre complet, certificat compris : docs/nginx.md.

# Limite de débit par adresse IP, devant le site : 30 requêtes par seconde (une page charge une vingtaine de fichiers),
# rafales absorbées plus bas par « burst ». Le site a ses propres limites sur l'API ; celle-ci couvre aussi les pages
# et les fichiers, qu'il ne compte pas. Une zone par site : son nom doit être unique sur la machine.
limit_req_zone $binary_remote_addr zone=__SITE_ID__:10m rate=30r/s;

# HTTP : uniquement le défi ACME de Let's Encrypt (obtention et renouvellement du certificat), tout le reste part en HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}

# --- bloc HTTPS : à ajouter une fois le premier certificat obtenu (docs/nginx.md), nginx refuse un certificat absent ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    include snippets/deny-hidden.conf;   # fichiers et dossiers cachés (.env, .git…) : jamais servis

    server_tokens off;                 # ne pas annoncer la version de nginx
    client_max_body_size 16m;          # photos de la galerie : 15 Mo max côté site

    # compression : par défaut nginx ne compresse que le HTML ; CSS, JS et réponses de l'API (JSON) en profitent
    # aussi (≈ 4× moins lourds). Pas text/event-stream : le flux du chat doit partir sans attendre.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml;

    location / {
        limit_req zone=__SITE_ID__ burst=120 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # envoi d'une photo : traitement puis dépôt sur le stockage, parfois plus d'une minute (délai par défaut de nginx : 60 s,
    # au-delà duquel le membre verrait une erreur alors que sa photo est publiée)
    location = /api/gallery {
        limit_req zone=__SITE_ID__ burst=120 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    # contrôle de santé : réservé à Docker, qui interroge le conteneur directement (chaque appel lit la base)
    location = /healthz { return 404; }

    # Le chat : flux temps réel (SSE), ni mise en tampon ni coupure au bout de 60 s
    location = /api/chat/stream {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
