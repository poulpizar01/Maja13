# La Maja 13 — site nginx (généré par vps-setup.sh depuis ce modèle : __DOMAIN__, __PORT__).
# HTTPS : lancer ensuite `certbot --nginx -d __DOMAIN__`, qui ajoute le certificat et la redirection.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 16m;          # photos de la galerie : 15 Mo max côté site

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Le Salon (chat) : flux temps réel (SSE), ni mise en tampon ni coupure au bout de 60 s
    location = /api/chat/stream {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
